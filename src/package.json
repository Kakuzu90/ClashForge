{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build && vite build --ssr",
        "typecheck": "vue-tsc --noEmit",
        "lint": "eslint . --max-warnings=0",
        "format": "prettier --write resources/js tests/js",
        "format:check": "prettier --check resources/js tests/js",
        "test": "vitest run"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@tailwindcss/vite": "^4.0.0",
        "@types/node": "^26.6.3",
        "@vitejs/plugin-vue": "^6.0.9",
        "@vue/eslint-config-prettier": "^10.2.0",
        "@vue/eslint-config-typescript": "^14.9.0",
        "@vue/test-utils": "^2.5.1",
        "axios": "^1.11.0",
        "concurrently": "^9.0.1",
        "eslint": "^10.11.0",
        "eslint-plugin-vue": "^10.11.1",
        "jsdom": "^30.1.1",
        "laravel-vite-plugin": "^2.0.0",
        "prettier": "^3.9.9",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "tailwindcss": "^4.0.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.71.0",
        "vite": "^7.0.7",
        "vitest": "^5.0.2",
        "vue-tsc": "^3.3.11"
    },
    "dependencies": {
        "@inertiajs/vue3": "^2.3.28",
        "vue": "^3.5.43"
    }
}
