includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 6
    paths:
        - app
        - config
        - routes
        - database
        # Test fixtures exercise Support primitives (e.g. EnumHelpers) before any module uses them.
        - tests/Support
    ignoreErrors:
        # Used by Pest test files, which PHPStan does not analyse.
        - identifier: trait.unused
          path: tests/Support/*
    tmpDir: storage/framework/cache/phpstan
