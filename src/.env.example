APP_NAME="Clash Commons"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# Production: LOG_STACK=json (structured JSON to stderr, specs/03 NFR-OBS-1).
LOG_SECURITY_DAYS=90

# Error tracking (specs/03 NFR-OBS-2). Empty DSN disables it. APP_RELEASE is set by the deploy.
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
APP_RELEASE=

# Proxy IPs/CIDRs to trust for client IPs (Cloudflare ranges in staging/production).
TRUSTED_PROXIES=

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=clashforge
DB_USERNAME=clashforge
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=20160
SESSION_ENCRYPT=true
# Secure cookies are on everywhere except APP_ENV=local unless set here.
# SESSION_SECURE_COOKIE=
# Key for stored IP hashes; falls back to APP_KEY when empty.
IP_HASH_SALT=
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Media storage (specs/10 §2.1). Local values target the compose `storage` profile
# (`docker compose --profile storage up -d`). Staging/production: the R2 endpoint, bucket and
# credentials, path style false, MEDIA_CDN_URL=https://cdn.<domain>, MEDIA_PRESIGN_HOST empty.
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=clashcommons-media
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true
MEDIA_DISK=media
MEDIA_CDN_URL=http://localhost:9000/clashcommons-media
# Browsers cannot resolve http://minio:9000, so URLs are signed for the host-mapped port.
MEDIA_PRESIGN_HOST=http://localhost:9000

VITE_APP_NAME="${APP_NAME}"

INERTIA_SSR_URL=http://ssr:13714
